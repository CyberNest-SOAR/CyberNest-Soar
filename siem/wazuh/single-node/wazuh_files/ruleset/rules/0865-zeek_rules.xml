<group name="zeek_custom, zeek, ids">
  <rule id="866001" level="3">
    <program_name>zeek</program_name>
    <match>^{</match>
    <description>Zeek: JSON event detected</description>
  </rule>

  <rule id="866002" level="5">
    <if_sid>866001</if_sid>
    <program_name>zeek</program_name>
    <match>"proto":"tcp"|"proto":"udp"|"proto":"icmp"</match>
    <description>Zeek: Network connection detected</description>
  </rule>

  <rule id="866003" level="10">
    <if_sid>866001</if_sid>
    <program_name>zeek</program_name>
    <match>"conn_state":"S0"|"conn_state":"S1"|"conn_state":"S2"|"conn_state":"S3"|"conn_state":"RSTO"|"conn_state":"OTH"</match>
    <description>Zeek: Suspicious connection state detected</description>
  </rule>

  <rule id="866004" level="6">
    <if_sid>866001</if_sid>
    <program_name>zeek</program_name>
    <match>"query":"</match>
    <description>Zeek: DNS query detected</description>
  </rule>

  <rule id="866005" level="6">
    <if_sid>866001</if_sid>
    <program_name>zeek</program_name>
    <match>"host":"</match>
    <description>Zeek: HTTP host detected</description>
  </rule>

  <rule id="866006" level="6">
    <if_sid>866001</if_sid>
    <program_name>zeek</program_name>
    <match>"server_name":"</match>
    <description>Zeek: SSL certificate name detected</description>
  </rule>
</group>