<group name="custom,sensor,zeek,suricata,ids">

  <rule id="100001" level="5">
    <decoded_as>zeek-json</decoded_as>
    <description>Zeek network sensor log received</description>
    <group>zeek,network_monitor</group>
  </rule>

  <rule id="100002" level="8">
    <decoded_as>zeek-json</decoded_as>
    <match>conn_state</match>
    <description>Zeek connection logged</description>
    <group>zeek,connections</group>
  </rule>

  <rule id="100011" level="5">
    <decoded_as>suricata-json</decoded_as>
    <description>Suricata IDS sensor log received</description>
    <group>suricata,ids,network_monitor</group>
  </rule>

  <rule id="100012" level="14">
    <decoded_as>suricata-json</decoded_as>
    <match>alert</match>
    <description>Suricata IDS alert triggered</description>
    <group>suricata,ids,alerts,threat</group>
  </rule>

  <rule id="100000" level="3">
    <decoded_as>catch-all-json</decoded_as>
    <description>Generic JSON log ingested</description>
  </rule>

  <rule id="100041" level="12">
    <if_sid>86601</if_sid>
    <field name="alert.signature">CVE-</field>
    <description>Suricata: High-Severity Alert with CVE reference - $(alert.signature)</description>
    <group>suricata,ids,exploit,cve</group>
  </rule>

  <rule id="100042" level="14">
    <if_sid>86601</if_sid>
    <field name="alert.signature">ET TROJAN|ET EXPLOIT|ET MALWARE</field>
    <description>Suricata: CRITICAL - Known Malware/Exploit detected - $(alert.signature)</description>
    <group>suricata,ids,malware,critical</group>
  </rule>

  <rule id="100043" level="12">
    <if_sid>86601</if_sid>
    <field name="alert.severity">1</field>
    <description>Suricata: CRITICAL severity alert - $(alert.signature)</description>
    <group>suricata,ids,critical</group>
  </rule>

  <rule id="100044" level="8">
    <if_sid>86601</if_sid>
    <field name="alert.severity">2</field>
    <description>Suricata: HIGH severity alert - $(alert.signature)</description>
    <group>suricata,ids,high</group>
  </rule>

</group>
